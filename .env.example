# Copy this file to .env and fill in the values below.
#   cp ".env.example" ".env"
# Then edit .env. Never edit this file directly, and never commit your real
# .env to version control (it's already excluded via .gitignore).
#
# Full explanation of every setting: see "Agency Customization.md"

# ── Required: the app will not start without these ──────────────────────────

# Generate with: openssl rand -hex 32
# Left blank on purpose. The app refuses to start with a blank or placeholder
# key rather than silently running with one that isn't actually secret.
SECRET_KEY=

# ── Admin account (first run only, see Agency Customization.md to change later) ──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!

# ── Branding: safe generic defaults, customize anytime ───────────────────────
BOARD_TITLE=Situational Awareness Board
FOOTER_CREDIT=
SHOW_LOGOS=true

# ── Weather: set these to your actual location ───────────────────────────────
WEATHER_LOCATION_NAME=your area
WEATHER_LAT=40.9106
WEATHER_LON=-90.6482
RADAR_STATION_ID=KDVN
NWS_CONTACT_EMAIL=admin@example.gov

# ── Email notifications (optional): blank = disabled, fails silently ────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_USE_TLS=true

# ── SMS alerts via Twilio (optional): blank = disabled, fails silently ───────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Shared read-only access (optional): blank = this login option is disabled ──
AGENCY_PASSWORD=

# ── Internet-facing deployment only: leave both false for internal/LAN use ──
FORCE_HTTPS=false
BEHIND_PROXY=false
